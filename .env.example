# --- Source de données ---
# "mock" (par défaut) ou "tmdb" une fois la clé configurée.
CONTENT_PROVIDER=mock

# --- TMDb (films & séries) ---
# Crée une clé sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# --- OMDb (optionnel : Rotten Tomatoes + IMDb pour un meilleur scoring) ---
# Clé gratuite (1000 req/jour) : https://www.omdbapi.com/apikey.aspx
# Sans clé, l'app retombe proprement sur le scoring TMDb seul.
OMDB_API_KEY=
OMDB_API_BASE_URL=https://www.omdbapi.com

# --- Google Books (livres : éditions FR, couvertures, résumés) ---
# Clé gratuite : https://console.cloud.google.com → activer "Books API" → Créer une clé API
GOOGLE_BOOKS_API_KEY=

# --- Spotify (musique : sorties récentes par genre, titres, playlists) ---
# App gratuite : https://developer.spotify.com/dashboard → Create app
# Redirect URI obligatoire (non utilisé ici) : http://127.0.0.1:3000
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Supabase (persistance des choix "À voir" / "Pas pour moi") ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
